{
  "name": "unplugin-inspector-lib-css",
  "type": "module",
  "version": "0.0.13",
  "packageManager": "pnpm@7.33.7",
  "description": "",
  "author": "Simon He",
  "license": "MIT",
  "funding": "https://github.com/sponsors/Simon-He95",
  "homepage": "https://github.com/Simon-He95/unplugin-Inspector-lib-css#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Simon-He95/unplugin-Inspector-lib-css.git"
  },
  "bugs": "https://github.com/Simon-He95/unplugin-Inspector-lib-css/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js",
      "require": "./dist/webpack.cjs"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js",
      "require": "./dist/esbuild.cjs"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js",
      "require": "./dist/rspack.cjs"
    },
    "./farm": {
      "types": "./dist/farm.d.ts",
      "import": "./dist/farm.js",
      "require": "./dist/farm.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ],
      "vite": [
        "./dist/vite.js",
        "./dist/vite.d.ts"
      ],
      "webpack": [
        "./dist/webpack.js",
        "./dist/webpack.d.ts"
      ],
      "esbuild": [
        "./dist/esbuild.js",
        "./dist/esbuild.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup ./src/index.ts ./src/vite.ts ./src/webpack.ts ./src/esbuild.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "nr build",
    "release": "bumpp && npm publish",
    "start": "esno src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.1.4",
    "@unocss/config": "0.61.0",
    "@unocss/core": "66.1.0-beta.13",
    "unplugin": "^1.16.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.12.0",
    "@antfu/ni": "^0.16.3",
    "@antfu/utils": "^0.5.2",
    "@types/node": "^18.19.87",
    "bumpp": "^8.2.1",
    "eslint": "^9.25.1",
    "esno": "^0.16.3",
    "tsup": "^8.4.0",
    "typescript": "^4.9.5",
    "vitest": "^3.1.2"
  }
}
